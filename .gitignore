# Semillero Microeconometría — .gitignore
# This repo holds CODE AND DOCUMENTATION ONLY. Data lives in Google Drive.
# See requirements-spec.md Rule 4 and logs/INCIDENTE_llave_id_unal_en_git.md

# ── Data: never commit ──
*.csv
*.tsv
*.xlsx
*.xls
*.xlsm
*.dta
*.sav
*.parquet
*.feather
*.rds
*.RData
*.rda
*.zip
*.rar
*.7z
*.gz

# ── Documents and binaries (go in Drive) ──
*.pdf
*.docx
*.doc
*.pptx

# ── Python / R / Jupyter clutter ──
__pycache__/
*.pyc
.ipynb_checkpoints/
.Rhistory
.Rproj.user/
.venv/
venv/

# ── Secrets ──
.env

# ── OS / editor ──
.DS_Store
Thumbs.db
desktop.ini
